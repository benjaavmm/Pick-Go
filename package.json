{
  "name": "pick-and-go",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pick&Go: pide en los locales de tu sede, elige la hora de retiro y sáltate la fila.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"node --watch server/index.js\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test \"server/**/*.test.js\""
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/caveat-brush": "^5.3.0",
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  }
}
