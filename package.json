{
  "name": "torugo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ToruGo: pide entre clases, retira en tu recreo y paga en la app o con tu beca Junaeb.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"node --watch server/index.js\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node server/index.js",
    "crear-admin": "node server/admin.js",
    "test": "node --test \"server/**/*.test.js\""
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "express": "^5.3.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.72.0",
    "nodemailer": "^10.5.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  }
}
